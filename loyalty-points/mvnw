#!/bin/sh
# Lightweight Maven Wrapper (script-only).
# Reads .mvn/wrapper/maven-wrapper.properties, downloads Maven once into ~/.m2/wrapper/dists, then runs it.
set -eu

BASE_DIR=$(cd "$(dirname "$0")" && pwd -P)
PROPS="$BASE_DIR/.mvn/wrapper/maven-wrapper.properties"

if [ ! -f "$PROPS" ]; then
  echo "Missing $PROPS" >&2
  exit 1
fi

DIST_URL=$(sed -n 's/^distributionUrl=//p' "$PROPS" | tr -d '\r' | head -n 1)
if [ -z "$DIST_URL" ]; then
  echo "distributionUrl not found in $PROPS" >&2
  exit 1
fi

DIST_FILE=${DIST_URL##*/}
DIST_NAME=${DIST_FILE%-bin.zip}
MAVEN_HOME_DIR=${MAVEN_USER_HOME:-$HOME/.m2}
INSTALL_DIR="$MAVEN_HOME_DIR/wrapper/dists/$DIST_NAME"
MVN_CMD="$INSTALL_DIR/$DIST_NAME/bin/mvn"

if [ ! -x "$MVN_CMD" ]; then
  echo "Downloading Maven: $DIST_URL" >&2
  mkdir -p "$INSTALL_DIR"
  TMP_FILE="$INSTALL_DIR/$DIST_FILE"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$TMP_FILE" "$DIST_URL"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$TMP_FILE" "$DIST_URL"
  else
    echo "Neither curl nor wget is available to download Maven." >&2
    exit 1
  fi
  unzip -q -o "$TMP_FILE" -d "$INSTALL_DIR"
  rm -f "$TMP_FILE"
  chmod +x "$MVN_CMD"
fi

MAVEN_PROJECTBASEDIR="$BASE_DIR"
export MAVEN_PROJECTBASEDIR
exec "$MVN_CMD" "$@"
